# Server Configuration
PORT=8080
ENVIRONMENT=development
SESSION_SECRET=super-secret-session-key-change-me-32chars

# PostgreSQL Database Connection
# Option 1: Direct Connection URL (Recommended for Render, Neon, Supabase, Docker)
DATABASE_URL=postgres://jobtracker_user:jobtracker_pass@localhost:5432/jobtracker_db?sslmode=disable

# Option 2: Render Internal / External URLs (Auto-detected if provided)
# INTERNAL_DATABASE_URL=postgres://user:pass@dpg-xxx-a:5432/dbname
# RENDER_DATABASE_URL=postgres://user:pass@dpg-xxx-a.oregon-postgres.render.com:5432/dbname

# Option 3: Discrete Database Credentials (Fallback if DATABASE_URL not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=jobtracker_user
# DB_PASSWORD=jobtracker_pass
# DB_NAME=jobtracker_db
# DB_SSLMODE=disable
